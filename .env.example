# Public site URL (Hub public URL, used for canonical/sitemap/OG)
NEXT_PUBLIC_SITE_URL=https://primegearlab.com/tesway-bike

# Spoke origin that serves /_next assets. Defaults to https://teswaybike1.vercel.app in
# next.config.mjs when unset. Override only if the Spoke deployment URL changes.
NEXT_PUBLIC_ASSET_PREFIX=

# Tracking (leave empty until you have real IDs; nothing loads when empty)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CTA_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
